{
  "expo": {
    "name": "AWS Community",
    "slug": "aws-community-companion",
    "scheme": "awscommunity",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#fff9ef" },
    "android": {
      "package": "org.awsday.community",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#fff9ef" }
    },
    "ios": { "bundleIdentifier": "org.awsday.community", "supportsTablet": true },
    "web": { "name": "AWS Community", "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
